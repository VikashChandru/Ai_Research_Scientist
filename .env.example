# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit or share your real .env file.

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROK_MODEL=llama-3.3-70b-versatile

# --- OpenAlex ---
# OpenAlex search itself is free and needs no key. Providing your email puts
# you in the faster "polite pool". If you have a paid OpenAlex API key, put
# it in OPENALEX_API_KEY (otherwise leave blank).
OPENALEX_EMAIL=your_email@example.com
OPENALEX_API_KEY=

# --- Neo4j AuraDB ---
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your_username
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# --- Sandbox ---
# Docker image used to run generated experiment code in isolation.
SANDBOX_DOCKER_IMAGE=ai-research-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60

# --- Agent limits (safe defaults, tune as you like) ---
MAX_SEARCH_QUERIES=4
MAX_PAPERS_PER_QUERY=8
MAX_HYPOTHESES=3
MAX_EXPERIMENT_RETRIES=2